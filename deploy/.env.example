# Planned configuration only. Copy to deploy/.env (never commit real values).
PLATFORM_PARENT_DOMAIN=localsplash.dev
AIDA_ADMIN_PUBLIC_URL=https://aida-admin.localsplash.dev
AIDA_PUBLIC_API_URL=https://aida-api.localsplash.dev
# Default loopback is suitable for host checks only. For containerized NPM use
# the dev server's private interface IP reachable from NPM, and firewall to NPM.
AIDA_PROXY_BIND_IP=127.0.0.1
AIDA_TRUSTED_PROXY_CIDRS=
# Select an unused subnet; update ALL static addresses together if changed.
AIDA_NETWORK_SUBNET=172.30.88.0/24
AIDA_ADMIN_IPV4=172.30.88.10
AIDA_RUNTIME_IPV4=172.30.88.11
AIDA_MYSQL_IPV4=172.30.88.12
AIDA_AGENT_IPV4=172.30.88.13

# Brand-new Aida-owned volume only. Generate EACH password independently with
# openssl rand -hex 32. App passwords must be exactly 64 hex characters so they
# can safely be used in both MySQL initialization and connection URLs.
AIDA_MYSQL_ROOT_PASSWORD=
AIDA_RUNTIME_DB_PASSWORD=
AIDA_ADMIN_DB_PASSWORD=
AIDA_RUNTIME_READER_DB_PASSWORD=
AIDA_ADMIN_SESSION_SECRET=

# Existing platform: Identity PR #18 and canonical PlatformConfig must be
# deployed/rehearsed before these applications are started against it.
IDENTITY_BASE_URL=https://id.localsplash.dev
AIDA_ID_TRUSTED_APP_CIDRS=
AIDA_ID_EVENT_SOURCE_CIDRS=
AIDA_ADMIN_ID_CLIENT_SECRET=
AIDA_RUNTIME_ID_CLIENT_SECRET=
NOCODB_BASE_URL=
AIDA_ADMIN_NOCODB_API_TOKEN=
AIDA_RUNTIME_NOCODB_API_TOKEN=

# Existing PBX: do not point these at aida-mysql. No Asterisk schema is created
# or migrated by this composition. Review the supported adapter grants.
OFFICEPULSE_INSTANCE_ID=dockerappvm01-dev
AIDA_ARI_URL=
AIDA_ARI_USERNAME=
AIDA_ARI_PASSWORD=
AIDA_ARI_APP=aida
AIDA_ASTERISK_MYSQL_HOST=
AIDA_ASTERISK_MYSQL_PORT=3306
AIDA_ASTERISK_MYSQL_USER=
AIDA_ASTERISK_MYSQL_PASSWORD=
AIDA_ASTERISK_MYSQL_DATABASE=asterisk
# To admit a remote PBX, use this server's PBX-facing private interface IP.
AIDA_PBX_BIND_IP=127.0.0.1
AIDA_FASTAGI_ADVERTISED_HOST=
AIDA_FASTAGI_PORT=4573

# Same project and worker name in OfficePulse and AidaAgent. The dev suffix
# prevents dispatch sharing with the pre-existing cloud aida-prime worker.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_HOST=
LIVEKIT_TRUNK_ENDPOINT=
AIDA_AGENT_NAME=aida-prime-dev
AIDA_STT_MODEL=deepgram/nova-3-general
AIDA_LLM_MODEL=openai/gpt-4.1-mini
AIDA_TTS_MODEL=cartesia/sonic-3
AIDA_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
AIDA_DEFAULT_LOCALE=en-US
